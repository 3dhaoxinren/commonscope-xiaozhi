+void Application::CsForgetFollow(){
+    cs_loop.clear();cs_follow_active_.store(false);cs_wait_reply_.store(false);cs_follow_audio_gate(false);
+}
+void Application::CsPollFollow(){
+    if(cs_loop.p==CsFollow::Off){
+        if(GetDeviceState()!=kDeviceStateListening)return;
+        // No window owner but the live state says listening: do not leave the mic open.
+        cs_loop.first_wake(cs_now());cs_follow_active_.store(true);
+        cs_loop.opened(cs_now(),cs_follow_audio_gate(true));
+    }
+    const bool allowed=protocol_ && protocol_->IsAudioChannelOpened() && !cs_maintenance_busy();
+    const auto a=cs_loop.poll(cs_now(),allowed,audio_service_.IsPlaybackIdle(),cs_follow_pulses());
+    if(a==CsFollow::Listen && GetDeviceState()==kDeviceStateSpeaking){
+        play_popup_on_listening_=false;
+        SetListeningMode(kListeningModeAutoStop);return;
+    }
+    if(a==CsFollow::None)return;
+    const auto why=cs_loop.end_code;CsForgetFollow();cs_voice_path_seen(8);if(why)cs_voice_path_seen(why);
+    // Publish the real idle transition to the panel before any network cleanup can block.
+    bool was_idle=GetDeviceState()==kDeviceStateIdle;
+    if(!was_idle)SetDeviceState(kDeviceStateIdle);
+    audio_service_.EnableVoiceProcessing(false);
+    while(audio_service_.PopPacketFromSendQueue()){}
+    if(protocol_ && protocol_->IsAudioChannelOpened())protocol_->CloseAudioChannel();
+    if(was_idle && !cs_maintenance_busy())audio_service_.EnableWakeWordDetection(true);
+}
+
+#endif
+void Application::CsPttIntent(unsigned mode) {
+    cs_ptt_intent_.store(mode);
+    Schedule([this, mode]() {
+        if (cs_ptt_intent_.load() != mode) return;
+        auto state = GetDeviceState();
+#if CONFIG_COMMONSCOPE_C3_BENCH
+        if (state == kDeviceStateWifiConfiguring && mode == 1) {
+            HandleStartListeningEvent();
+            return;
+        }
+        if (state == kDeviceStateAudioTesting && (mode == 2 || mode == 3)) {
+            HandleStopListeningEvent();
+            return;
+        }
+#endif
+        if (mode == 1 && state == kDeviceStateIdle) {
+#if CONFIG_BOARD_TYPE_COMMONSCOPE_C3_PTT && CONFIG_USE_ESP_WAKE_WORD
+            if(CsFollowActive()) return;
+#endif
+
+            HandleStartListeningEvent();
+        } else if (mode == 2 && state == kDeviceStateListening) {
+#if CONFIG_BOARD_TYPE_COMMONSCOPE_C3_PTT && CONFIG_USE_ESP_WAKE_WORD
+            if(listening_mode_!=kListeningModeManualStop)return;
+            cs_loop.submit(cs_now());cs_wait_reply_.store(true);cs_follow_audio_gate(false);cs_follow_active_.store(true);
+#endif
+            HandleStopListeningEvent();
+#if CONFIG_BOARD_TYPE_COMMONSCOPE_C3_PTT && CONFIG_USE_ESP_WAKE_WORD
+            if (listening_mode_ == kListeningModeManualStop && GetDeviceState() == kDeviceStateIdle)
+                cs_voice_path_seen(6);
+#endif
+        } else if ((mode == 3 && (state == kDeviceStateConnecting || state == kDeviceStateListening)) ||
+                   (mode == 2 && state == kDeviceStateConnecting)) {
+            if (protocol_ && protocol_->IsAudioChannelOpened()) protocol_->CloseAudioChannel();
+            SetDeviceState(kDeviceStateIdle);
+        }
+    });
+}
