+
+void Application::CsPttIntent(unsigned mode){
+    cs_ptt_intent_.store(mode);
+    Schedule([this,mode](){
+        if(cs_ptt_intent_.load()!=mode)return;
+        if(mode==1 && GetDeviceState()==kDeviceStateIdle)HandleStartListeningEvent();
+        else if(mode==2 && GetDeviceState()==kDeviceStateListening)HandleStopListeningEvent();
+        else if(mode==3 || (mode==2 && GetDeviceState()==kDeviceStateConnecting)){
+            if(protocol_ && protocol_->IsAudioChannelOpened())protocol_->CloseAudioChannel();
+            SetDeviceState(kDeviceStateIdle);
+        }
+    });
+}
